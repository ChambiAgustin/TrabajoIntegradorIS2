<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Comunidad y Foros - Aula Virtual</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
        }
    </style>
</head>
<body class="bg-slate-50 text-slate-800 min-h-screen flex flex-col">

    <!-- Header / Navbar -->
    <header class="bg-white border-b border-slate-200 sticky top-0 z-50 px-6 py-4 shadow-sm">
        <div class="max-w-7xl mx-auto flex justify-between items-center">
            <div class="flex items-center space-x-3">
                <span class="bg-gradient-to-tr from-blue-600 to-indigo-600 text-white p-2.5 rounded-xl font-bold text-lg shadow-md shadow-blue-100">AV</span>
                <h1 class="text-xl font-bold tracking-tight text-slate-900">Aula Virtual</h1>
            </div>
            <div class="flex items-center space-x-4">
                <div class="flex items-center space-x-2">
                    <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 animate-pulse"></span>
                    <span class="text-xs text-slate-500">Conectado como <strong class="text-slate-800 font-semibold">{{currentUser}}</strong></span>
                </div>
                <a href="/dashboard" class="text-xs font-semibold bg-slate-100 hover:bg-slate-200 text-slate-700 px-4 py-2 rounded-xl transition duration-200">
                    Volver al Panel
                </a>
            </div>
        </div>
    </header>

    <!-- Main Content Area -->
    <main class="flex-grow max-w-7xl w-full mx-auto p-6 flex flex-col md:flex-row gap-6">
        
        <!-- Sidebar: Commissions Selector -->
        <aside class="w-full md:w-80 bg-white border border-slate-200 rounded-2xl shadow-sm flex flex-col overflow-hidden self-start">
            <div class="p-5 border-b border-slate-100 bg-slate-50/50">
                <h2 class="font-bold text-slate-900 flex items-center space-x-2.5">
                    <svg class="w-5 h-5 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/>
                    </svg>
                    <span>Tus Comisiones</span>
                </h2>
                <p class="text-xs text-slate-500 mt-1">Selecciona una comisión para visualizar su cartelera pública.</p>
            </div>
            
            <div class="p-3 space-y-2 max-h-[400px] overflow-y-auto">
                {{#myCommissions}}
                <a href="/comunidad?commission={{id_comision}}" 
                   class="block p-4 rounded-xl border border-slate-100 hover:border-indigo-500 hover:bg-indigo-50/30 transition duration-200 bg-white shadow-sm flex flex-col space-y-1">
                    <span class="text-sm font-bold text-indigo-600 truncate">{{materia_nombre}}</span>
                    <span class="text-xs text-slate-500 flex items-center space-x-1">
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                        </svg>
                        <span>{{horario}}</span>
                    </span>
                </a>
                {{/myCommissions}}
                {{^myCommissions}}
                <div class="text-center py-10">
                    <span class="text-3xl block mb-2">📭</span>
                    <p class="text-xs text-slate-400">No participas de ninguna comisión.</p>
                </div>
                {{/myCommissions}}
            </div>
        </aside>

        <!-- Message/Forum Board -->
        <section class="flex-grow flex flex-col min-w-0">
            {{#selectedCommissionId}}
            
            <!-- Banner / Google Classroom Header Card -->
            <div class="relative rounded-2xl overflow-hidden mb-6 bg-gradient-to-r from-blue-700 via-indigo-700 to-violet-800 text-white shadow-lg p-8 md:p-10 flex flex-col justify-end min-h-[160px] md:min-h-[200px]">
                <div class="absolute inset-0 bg-black opacity-10"></div>
                <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,_var(--tw-gradient-stops))] from-white/10 via-transparent to-transparent"></div>
                <div class="relative z-10">
                    <h2 class="text-2xl md:text-3xl font-extrabold tracking-tight">{{commissionTitle}}</h2>
                    <p class="text-sm md:text-base text-indigo-100 font-medium mt-1">Tablero de Novedades y Comunidad</p>
                </div>
                <span class="absolute top-5 right-5 text-4xl opacity-20 select-none">🏫</span>
            </div>

            <!-- Alerts: Error & Success Messages -->
            {{#errorMessage}}
            <div class="bg-red-50 border border-red-200 text-red-700 px-5 py-4 rounded-xl mb-6 flex items-start space-x-3 text-sm animate-fade-in shadow-sm">
                <span class="text-lg">⚠️</span>
                <div class="flex-1 font-medium">{{errorMessage}}</div>
            </div>
            {{/errorMessage}}

            {{#successMessage}}
            <div class="bg-emerald-50 border border-emerald-200 text-emerald-700 px-5 py-4 rounded-xl mb-6 flex items-start space-x-3 text-sm animate-fade-in shadow-sm">
                <span class="text-lg">✅</span>
                <div class="flex-1 font-medium">{{successMessage}}</div>
            </div>
            {{/successMessage}}

            <!-- Main Layout: Grid structure like Classroom -->
            <div class="flex flex-col lg:flex-row gap-6">
                
                <!-- Left Sidebar Details (Narrow Column) -->
                <div class="w-full lg:w-60 flex-shrink-0 space-y-6">
                    <div class="bg-white border border-slate-200 rounded-xl p-5 shadow-sm">
                        <h4 class="font-bold text-slate-800 text-xs tracking-wider uppercase mb-3">Información del Curso</h4>
                        <div class="space-y-3 text-xs text-slate-600">
                            <div>
                                <p class="font-semibold text-slate-400">Modalidad</p>
                                <p class="text-slate-800 mt-0.5">Presencial / Aula Virtual</p>
                            </div>
                            <div>
                                <p class="font-semibold text-slate-400">Comisión ID</p>
                                <p class="text-slate-800 mt-0.5">#{{selectedCommissionId}}</p>
                            </div>
                            <div class="pt-2 border-t border-slate-100">
                                <p class="text-[11px] text-slate-400 leading-relaxed">
                                    Aquí encontrarás las comunicaciones del docente, material adjunto y podrás interactuar con tus compañeros.
                                </p>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Center Content: Announcements Stream -->
                <div class="flex-grow space-y-6">
                    
                    <!-- Post input form (Only Teachers and Admins) -->
                    {{#isDocenteRole}}
                    <div class="bg-white border border-slate-200 rounded-xl shadow-sm p-4 transition-all duration-200" id="announcementBox">
                        <!-- Collapsed View -->
                        <div id="collapsedForm" class="flex items-center space-x-4 cursor-pointer py-1" onclick="expandPostForm()">
                            <div class="w-10 h-10 rounded-full bg-indigo-100 text-indigo-700 flex items-center justify-center font-bold text-sm">
                                {{currentUser.substring(0,2).toUpperCase}}
                            </div>
                            <div class="flex-grow text-xs text-slate-400 font-medium hover:text-slate-600 transition">
                                Anuncia algo a tu clase...
                            </div>
                        </div>

                        <!-- Expanded View (Hidden by default) -->
                        <form action="/comunidad" method="post" enctype="multipart/form-data" id="expandedForm" class="hidden space-y-4 pt-1">
                            <input type="hidden" name="id_comision" value="{{selectedCommissionId}}">
                            
                            <div class="flex items-start space-x-4">
                                <div class="w-10 h-10 rounded-full bg-indigo-600 text-white flex items-center justify-center font-bold text-sm">
                                    {{currentUser.substring(0,2).toUpperCase}}
                                </div>
                                <div class="flex-grow">
                                    <textarea name="contenido" rows="4" required 
                                              placeholder="Escribe un anuncio, consulta o mensaje para la clase..."
                                              class="w-full border-0 focus:ring-0 focus:outline-none resize-none text-sm text-slate-800 placeholder-slate-400"
                                              id="announcementTextarea"></textarea>
                                </div>
                            </div>

                            <!-- List of selected files -->
                            <div id="fileList" class="grid grid-cols-1 md:grid-cols-2 gap-3 px-1">
                                <!-- Dynamic elements will be appended here -->
                            </div>

                            <!-- Controls Footer -->
                            <div class="flex items-center justify-between border-t border-slate-100 pt-4 px-1">
                                <div class="flex items-center space-x-2">
                                    <input type="file" name="archivos" id="fileInput" class="hidden" multiple onchange="handleFileSelection(this)">
                                    <button type="button" onclick="document.getElementById('fileInput').click()" 
                                            class="flex items-center space-x-2 px-4 py-2 bg-slate-100 hover:bg-slate-200 active:bg-slate-300 text-slate-700 rounded-xl text-xs font-semibold transition duration-150">
                                        <svg class="w-4 h-4 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.172 7l-6.586 6.586a2 2 0 102.828 2.828l6.414-6.586a4 4 0 00-5.656-5.656l-6.415 6.585a6 6 0 108.486 8.486L20.5 13"/>
                                        </svg>
                                        <span>Adjuntar archivos</span>
                                    </button>
                                    <button type="button" onclick="clearSelectedFiles()" id="clearBtn" 
                                            class="hidden text-xs text-red-500 hover:text-red-700 font-semibold px-2 py-1">
                                        Limpiar
                                    </button>
                                </div>
                                <div class="flex items-center space-x-3">
                                    <button type="button" onclick="collapsePostForm()" 
                                            class="px-4 py-2 hover:bg-slate-100 active:bg-slate-200 text-slate-600 rounded-xl text-xs font-semibold transition">
                                        Cancelar
                                    </button>
                                    <button type="submit" 
                                            class="bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-2 px-6 rounded-xl text-xs shadow-md shadow-indigo-100 transition">
                                        Publicar
                                    </button>
                                </div>
                            </div>
                        </form>
                    </div>
                    {{/isDocenteRole}}

                    <!-- Stream Feed / Cards -->
                    {{#posts}}
                    <article class="bg-white border border-slate-200 rounded-xl shadow-sm overflow-hidden">
                        
                        <!-- Post Header -->
                        <div class="p-6 pb-4 flex items-start justify-between">
                            <div class="flex items-center space-x-3.5">
                                <div class="w-10 h-10 rounded-full bg-slate-100 text-slate-700 font-bold text-sm flex items-center justify-center border border-slate-200">
                                    {{emisorInitials}}
                                </div>
                                <div>
                                    <div class="flex items-center space-x-2">
                                        <span class="text-sm font-bold text-slate-900">@{{emisor_nombre}}</span>
                                        {{#isDocenteEmisor}}
                                        <span class="bg-indigo-50 border border-indigo-100 text-indigo-700 text-[10px] font-bold px-2 py-0.5 rounded-full">Docente</span>
                                        {{/isDocenteEmisor}}
                                    </div>
                                    <span class="text-[11px] text-slate-400 mt-0.5 block">{{fecha}}</span>
                                </div>
                            </div>
                        </div>

                        <!-- Post Body Content -->
                        <div class="px-6 pb-5">
                            <p class="text-sm text-slate-700 whitespace-pre-line leading-relaxed">{{contenido}}</p>
                        </div>

                        <!-- Post Attachments -->
                        {{#hasAttachments}}
                        <div class="px-6 pb-6 pt-1 border-t border-slate-50/50">
                            <h4 class="text-[11px] font-bold text-slate-400 uppercase tracking-wider mb-2.5">Archivos Adjuntos</h4>
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                                {{#attachments}}
                                <a href="/comunidad/download/{{id_adjunto}}" target="_blank"
                                   class="group flex items-center justify-between p-3.5 rounded-xl border border-slate-200 hover:border-indigo-400 hover:bg-indigo-50/20 transition duration-200 bg-slate-50/50">
                                    <div class="flex items-center space-x-3 overflow-hidden pr-2">
                                        <div class="w-8 h-8 rounded-lg bg-indigo-50 text-indigo-600 flex items-center justify-center flex-shrink-0 font-bold text-sm">
                                            📄
                                        </div>
                                        <div class="truncate text-left">
                                            <p class="text-xs font-semibold text-slate-700 group-hover:text-indigo-600 truncate transition duration-150">{{nombre_archivo}}</p>
                                            <p class="text-[10px] text-slate-400 mt-0.5">Haz clic para descargar</p>
                                        </div>
                                    </div>
                                    <div class="text-slate-400 group-hover:text-indigo-600 flex-shrink-0 transition duration-150">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/>
                                        </svg>
                                    </div>
                                </a>
                                {{/attachments}}
                            </div>
                        </div>
                        {{/hasAttachments}}

                        <!-- Comments section -->
                        <div class="bg-slate-50/60 border-t border-slate-100 p-6 space-y-4">
                            
                            <!-- Comments Header -->
                            <div class="flex items-center space-x-2 text-xs font-semibold text-slate-500">
                                <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>
                                </svg>
                                <span>{{commentsCount}} comentario(s) de la clase</span>
                            </div>

                            <!-- Comments List -->
                            {{#hasComments}}
                            <div class="space-y-4 pt-1">
                                {{#comments}}
                                <div class="flex items-start space-x-3">
                                    <div class="w-8 h-8 rounded-full bg-slate-200 text-slate-600 font-bold text-xs flex items-center justify-center border border-slate-300 flex-shrink-0">
                                        {{emisorInitials}}
                                    </div>
                                    <div class="flex-grow bg-white border border-slate-100 rounded-2xl px-4 py-3 shadow-xs">
                                        <div class="flex items-baseline justify-between">
                                            <div class="flex items-center space-x-2">
                                                <span class="text-xs font-bold text-slate-900">@{{emisor_nombre}}</span>
                                                {{#isDocenteEmisor}}
                                                <span class="bg-indigo-50 text-indigo-700 text-[9px] font-bold px-1.5 py-0.2 rounded">Docente</span>
                                                {{/isDocenteEmisor}}
                                            </div>
                                            <span class="text-[9px] text-slate-400">{{fecha}}</span>
                                        </div>
                                        <p class="text-xs text-slate-600 mt-1 leading-relaxed whitespace-pre-line">{{contenido}}</p>
                                    </div>
                                </div>
                                {{/comments}}
                            </div>
                            {{/hasComments}}

                            <!-- Add comment form -->
                            <form action="/comunidad" method="post" class="flex items-center space-x-3 pt-2">
                                <input type="hidden" name="id_comision" value="{{selectedCommissionId}}">
                                <input type="hidden" name="id_padre" value="{{id_mensaje}}">
                                
                                <div class="w-8 h-8 rounded-full bg-indigo-100 text-indigo-700 font-bold text-xs flex items-center justify-center border border-indigo-200 flex-shrink-0">
                                    {{currentUser.substring(0,2).toUpperCase}}
                                </div>
                                <div class="flex-grow relative">
                                    <input type="text" name="contenido" required 
                                           placeholder="Añadir un comentario de clase..."
                                           class="w-full bg-white border border-slate-200 rounded-full pl-4 pr-10 py-2 text-xs text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-1 focus:ring-indigo-500 focus:border-indigo-500 transition duration-150 shadow-xs">
                                    <button type="submit" 
                                            class="absolute right-2.5 top-1.5 text-indigo-600 hover:text-indigo-800 transition duration-150 p-1 rounded-full hover:bg-slate-50">
                                        <svg class="w-4 h-4 transform rotate-90" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/>
                                        </svg>
                                    </button>
                                </div>
                            </form>

                        </div>
                    </article>
                    {{/posts}}

                    {{^posts}}
                    <!-- Empty State -->
                    <div class="bg-white border border-slate-200 rounded-xl p-12 text-center text-slate-400 shadow-sm flex flex-col items-center">
                        <div class="w-20 h-20 bg-slate-50 rounded-full flex items-center justify-center text-slate-300 text-4xl mb-4 border border-slate-100">
                            📢
                        </div>
                        <h3 class="text-base font-bold text-slate-800 mb-1">El tablero está vacío</h3>
                        <p class="max-w-md text-xs text-slate-500 leading-relaxed mt-1">
                            {{#isDocenteRole}}
                            ¡Inicia la conversación creando un anuncio para tus alumnos! Puedes redactar un mensaje informativo y adjuntar archivos de soporte.
                            {{/isDocenteRole}}
                            {{^isDocenteRole}}
                            Aún no se han publicado anuncios ni consultas en esta comisión.
                            {{/isDocenteRole}}
                        </p>
                    </div>
                    {{/posts}}

                </div>
            </div>

            {{/selectedCommissionId}}

            {{^selectedCommissionId}}
            <!-- Placeholder when no commission is selected -->
            <div class="bg-white border border-slate-200 rounded-2xl p-16 text-center text-slate-400 flex flex-col items-center justify-center shadow-sm flex-grow min-h-[400px]">
                <div class="w-20 h-20 rounded-full bg-slate-50 flex items-center justify-center text-slate-400 mb-6 border border-slate-100">
                    <svg class="w-10 h-10 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>
                    </svg>
                </div>
                <h3 class="text-lg font-bold text-slate-800 mb-2">Comunidad y Foros</h3>
                <p class="max-w-sm text-xs text-slate-500 leading-relaxed">
                    Selecciona una comisión del panel izquierdo para ver el tablón de anuncios, descargar apuntes y participar de los debates.
                </p>
            </div>
            {{/selectedCommissionId}}
        </section>

    </main>

    <!-- JavaScript to handle Expandable Post Form and File selection details -->
    <script>
        function expandPostForm() {
            document.getElementById('collapsedForm').classList.add('hidden');
            document.getElementById('expandedForm').classList.remove('hidden');
            document.getElementById('announcementTextarea').focus();
        }

        function collapsePostForm() {
            document.getElementById('expandedForm').classList.add('hidden');
            document.getElementById('collapsedForm').classList.remove('hidden');
            document.getElementById('announcementTextarea').value = '';
            clearSelectedFiles();
        }

        function handleFileSelection(input) {
            const list = document.getElementById('fileList');
            const clearBtn = document.getElementById('clearBtn');
            list.innerHTML = '';
            
            if (input.files.length > 0) {
                clearBtn.classList.remove('hidden');
                for (let i = 0; i < input.files.length; i++) {
                    const file = input.files[i];
                    const sizeKB = (file.size / 1024).toFixed(1);
                    list.innerHTML += `
                        <div class="flex items-center justify-between bg-slate-50 border border-slate-200 rounded-xl p-3 text-xs shadow-xs animate-fade-in">
                            <div class="flex items-center space-x-2.5 overflow-hidden pr-2">
                                <span class="text-base flex-shrink-0">📄</span>
                                <div class="truncate">
                                    <p class="font-semibold text-slate-700 truncate">${file.name}</p>
                                    <p class="text-[10px] text-slate-400 mt-0.5">${sizeKB} KB</p>
                                </div>
                            </div>
                        </div>
                    `;
                }
            } else {
                clearBtn.classList.add('hidden');
            }
        }

        function clearSelectedFiles() {
            const input = document.getElementById('fileInput');
            input.value = '';
            handleFileSelection(input);
        }
    </script>

</body>
</html>
