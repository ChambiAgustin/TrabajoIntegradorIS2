<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Notificaciones y Alertas - Aula Virtual</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
        }
    </style>
</head>
<body class="bg-slate-50 text-slate-800 min-h-screen flex flex-col">

    <!-- Header / Navbar -->
    <header class="bg-white border-b border-slate-200 sticky top-0 z-50 px-6 py-4 shadow-sm">
        <div class="max-w-7xl mx-auto flex justify-between items-center">
            <div class="flex items-center space-x-3">
                <span class="bg-gradient-to-tr from-blue-600 to-indigo-600 text-white p-2 rounded-lg font-bold text-lg shadow-md shadow-blue-200">AV</span>
                <h1 class="text-xl font-bold tracking-tight text-slate-900">Aula Virtual</h1>
            </div>
            <div class="flex items-center space-x-4">
                <span class="text-sm text-slate-500">Conectado como <strong class="text-slate-800 font-semibold">{{currentUser}}</strong></span>
                <a href="/dashboard" class="text-sm font-semibold text-indigo-600 hover:text-indigo-700 transition">Volver al Panel</a>
            </div>
        </div>
    </header>

    <!-- Main Content -->
    <main class="flex-grow max-w-2xl w-full mx-auto p-6 md:p-8 flex flex-col space-y-6">
        
        <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
            <div>
                <h2 class="text-2xl font-extrabold tracking-tight text-slate-900">Centro de Notificaciones</h2>
                <p class="text-xs text-slate-500 mt-1">Revisa tus novedades sobre calificaciones, foros comunitarios e inscripciones.</p>
            </div>
            
            {{#hasNotifications}}
            <form action="/notificaciones/read" method="post">
                <button type="submit" class="text-xs font-bold text-indigo-600 hover:text-indigo-700 transition bg-indigo-50 hover:bg-indigo-100/80 px-4 py-2 rounded-xl border border-indigo-100">
                    Marcar todo como leído
                </button>
            </form>
            {{/hasNotifications}}
        </div>

        <!-- Notifications List -->
        <div class="space-y-3">
            {{#notifications}}
            <div class="p-4 bg-white rounded-2xl border {{#leida}}border-slate-200/80 bg-white/70{{/leida}}{{^leida}}border-indigo-100 bg-indigo-50/10 shadow-sm{{/leida}} flex justify-between items-center gap-4 transition duration-300">
                <div class="flex items-start space-x-3 min-w-0">
                    <span class="text-lg select-none py-1">
                        {{^leida}}✉️{{/leida}}
                        {{#leida}}📩{{/leida}}
                    </span>
                    <div class="min-w-0">
                        <p class="text-xs {{^leida}}font-bold text-slate-900{{/leida}}{{#leida}}font-medium text-slate-600{{/leida}}">{{contenido}}</p>
                        <span class="text-[9px] text-slate-400 mt-1 block">{{fecha}}</span>
                    </div>
                </div>

                {{^leida}}
                <form action="/notificaciones/read" method="post" class="shrink-0">
                    <input type="hidden" name="id_notificacion" value="{{id}}">
                    <button type="submit" class="p-1 hover:bg-slate-100 rounded-lg text-slate-400 hover:text-indigo-600 transition" title="Marcar como leído">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-4 h-4">
                            <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
                        </svg>
                    </button>
                </form>
                {{/leida}}
            </div>
            {{/notifications}}
            
            {{^notifications}}
            <div class="bg-white rounded-2xl border border-slate-200 p-12 text-center text-slate-400">
                <span class="text-3xl mb-2 block select-none">🔕</span>
                <p class="text-sm font-medium">No tienes notificaciones o alertas en este momento.</p>
            </div>
            {{/notifications}}
        </div>

    </main>

    <!-- Footer -->
    <footer class="bg-white border-t border-slate-200 py-6 px-6 text-center text-xs text-slate-500">
        <p>&copy; 2026 Aula Virtual - Trabajo Integrador IS2.</p>
    </footer>

</body>
</html>
