<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Usuarios Registrados - Panel de Admin</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
        }
    </style>
</head>
<body class="bg-slate-50 text-slate-800 min-h-screen flex flex-col">

    <!-- Header / Navbar -->
    <header class="bg-white border-b border-slate-200 sticky top-0 z-50 px-6 py-4 shadow-sm">
        <div class="max-w-7xl mx-auto flex justify-between items-center">
            <div class="flex items-center space-x-3">
                <span class="bg-gradient-to-tr from-slate-700 to-slate-900 text-white p-2.5 rounded-xl font-bold text-lg shadow-md">AD</span>
                <div>
                    <h1 class="text-sm font-bold tracking-tight text-slate-900">Panel de Control</h1>
                    <p class="text-[10px] text-slate-400 font-semibold tracking-wider uppercase">Administración</p>
                </div>
            </div>
            
            <nav class="hidden md:flex items-center space-x-6">
                <a href="/admin/pendientes" class="text-xs font-semibold text-slate-500 hover:text-slate-900 transition">Pendientes</a>
                <a href="/admin/usuarios" class="text-xs font-bold text-indigo-600 border-b-2 border-indigo-600 pb-1">Usuarios</a>
                <a href="/dashboard" class="text-xs font-semibold text-slate-500 hover:text-slate-900 transition">Dashboard General</a>
            </nav>

            <div class="flex items-center space-x-4">
                <span class="text-xs text-slate-500">Sesión: <strong class="text-slate-800 font-semibold">{{currentUser}}</strong></span>
                <a href="/logout" class="text-xs font-bold bg-red-50 hover:bg-red-100 text-red-600 px-4 py-2 rounded-xl transition duration-150">
                    Cerrar Sesión
                </a>
            </div>
        </div>
    </header>

    <!-- Main Container -->
    <main class="flex-grow max-w-7xl w-full mx-auto p-6 space-y-6">
        
        <!-- Header Section -->
        <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
            <div>
                <h2 class="text-xl font-extrabold text-slate-900">Listado General de Usuarios</h2>
                <p class="text-xs text-slate-500 mt-1">Habilita, deshabilita o gestiona el estado de todos los alumnos y docentes registrados en el sistema.</p>
            </div>
            <a href="/admin/pendientes" class="text-xs font-bold text-indigo-600 bg-indigo-50 hover:bg-indigo-100 px-4 py-2.5 rounded-xl transition duration-150">
                ← Ver Pendientes de Aprobación
            </a>
        </div>

        <!-- Alerts -->
        <div id="alerts-container" class="space-y-4">
            {{#errorMessage}}
            <div class="bg-red-50 border border-red-200 text-red-700 px-5 py-4 rounded-xl flex items-start space-x-3 text-xs shadow-sm">
                <span class="text-base">⚠️</span>
                <div class="flex-1 font-medium">{{errorMessage}}</div>
            </div>
            {{/errorMessage}}

            {{#successMessage}}
            <div class="bg-emerald-50 border border-emerald-200 text-emerald-700 px-5 py-4 rounded-xl flex items-start space-x-3 text-xs shadow-sm">
                <span class="text-base">✅</span>
                <div class="flex-1 font-medium">{{successMessage}}</div>
            </div>
            {{/successMessage}}
        </div>

        <!-- CONTENEDORES DESPLEGABLES DE USUARIOS -->
        <div id="users-main-container">
            {{#hasUsuarios}}
            <div class="space-y-6">

            <!-- SECCIÓN: DOCENTES -->
            <div class="bg-white border border-slate-200 rounded-2xl shadow-sm overflow-hidden">
                <button onclick="toggleSection('section-docentes', 'chevron-docentes')" class="w-full flex justify-between items-center p-5 bg-slate-50 hover:bg-slate-100/80 transition duration-150 text-left focus:outline-none">
                    <div class="flex items-center space-x-3">
                        <span class="text-xl">👨‍🏫</span>
                        <div>
                            <h3 class="text-sm font-bold text-slate-800">Docentes ({{docentesCount}})</h3>
                            <p class="text-[10px] text-slate-400 font-semibold tracking-wider uppercase">Listado general de profesores registrados</p>
                        </div>
                    </div>
                    <svg id="chevron-docentes" class="w-5 h-5 text-slate-400 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                    </svg>
                </button>
                
                <div id="section-docentes" class="hidden border-t border-slate-100">
                    {{#hasDocentes}}
                    <div class="overflow-x-auto">
                        <table class="w-full text-left border-collapse">
                            <thead>
                                <tr class="bg-slate-50/50 border-b border-slate-200 text-[10px] font-bold text-slate-400 uppercase tracking-wider">
                                    <th class="p-4 pl-6">Nombre Completo</th>
                                    <th class="p-4">DNI / Usuario</th>
                                    <th class="p-4">Email</th>
                                    <th class="p-4">Estado</th>
                                    <th class="p-4">Fecha Registro</th>
                                    <th class="p-4 pr-6 text-right">Acciones</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-100 text-xs">
                                {{#docentes}}
                                <tr class="hover:bg-slate-50/50 transition duration-150">
                                    <td class="p-4 pl-6 font-semibold text-slate-900">{{nombre}} {{apellido}}</td>
                                    <td class="p-4 text-slate-500 font-mono">{{username}}</td>
                                    <td class="p-4 text-slate-500">{{email}}</td>
                                    <td class="p-4">
                                        {{#isActivo}}
                                        <span class="bg-emerald-50 border border-emerald-100 text-emerald-700 text-[9px] font-bold px-2 py-0.5 rounded-full">Activo</span>
                                        {{/isActivo}}
                                        {{#isDeshabilitado}}
                                        <span class="bg-slate-100 border border-slate-200 text-slate-500 text-[9px] font-bold px-2 py-0.5 rounded-full">Deshabilitado</span>
                                        {{/isDeshabilitado}}
                                        {{#isPendiente}}
                                        <span class="bg-amber-50 border border-amber-100 text-amber-700 text-[9px] font-bold px-2 py-0.5 rounded-full">Pendiente</span>
                                        {{/isPendiente}}
                                        {{#isRechazado}}
                                        <span class="bg-red-50 border border-red-100 text-red-700 text-[9px] font-bold px-2 py-0.5 rounded-full">Rechazado</span>
                                        {{/isRechazado}}
                                    </td>
                                    <td class="p-4 text-slate-400">{{creado_en}}</td>
                                     <td class="p-4 pr-6 text-right">
                                         <div class="inline-flex items-center space-x-2">
                                             {{#isActivo}}
                                             <form action="/admin/deshabilitar/{{id}}" method="post" onsubmit="return handleUserForm(event, this);" class="inline">
                                                 <button type="submit" class="bg-red-50 hover:bg-red-100 text-red-600 font-semibold px-3 py-1.5 rounded-lg text-[10px] transition duration-150">
                                                     Deshabilitar
                                                 </button>
                                             </form>
                                             {{/isActivo}}
                                             {{#isDeshabilitado}}
                                             <form action="/admin/habilitar/{{id}}" method="post" onsubmit="return handleUserForm(event, this);" class="inline">
                                                 <button type="submit" class="bg-emerald-600 hover:bg-emerald-700 text-white font-semibold px-3 py-1.5 rounded-lg text-[10px] transition duration-150">
                                                     Habilitar
                                                 </button>
                                             </form>
                                             {{/isDeshabilitado}}
                                             <form action="/admin/eliminar/{{id}}" method="post" onsubmit="return handleUserForm(event, this, '¿Seguro que deseas eliminar a este docente permanentemente? Esta acción es irreversible y borrará todos sus datos e historial.');" class="inline">
                                                 <button type="submit" class="bg-red-600 hover:bg-red-700 text-white font-semibold px-3 py-1.5 rounded-lg text-[10px] transition duration-150">
                                                     Eliminar
                                                 </button>
                                             </form>
                                         </div>
                                     </td>
                                </tr>
                                {{/docentes}}
                            </tbody>
                        </table>
                    </div>
                    {{/hasDocentes}}
                    {{^hasDocentes}}
                    <div class="p-8 text-center text-slate-400 text-xs">No hay docentes registrados.</div>
                    {{/hasDocentes}}
                </div>
            </div>

            <!-- SECCIÓN: ALUMNOS (AGRUPADOS POR AÑO) -->
            <div class="bg-white border border-slate-200 rounded-2xl shadow-sm overflow-hidden">
                <button onclick="toggleSection('section-alumnos', 'chevron-alumnos')" class="w-full flex justify-between items-center p-5 bg-slate-50 hover:bg-slate-100/80 transition duration-150 text-left focus:outline-none">
                    <div class="flex items-center space-x-3">
                        <span class="text-xl">🎓</span>
                        <div>
                            <h3 class="text-sm font-bold text-slate-800">Alumnos ({{alumnosCount}})</h3>
                            <p class="text-[10px] text-slate-400 font-semibold tracking-wider uppercase">Listado de alumnos clasificados por año de registro</p>
                        </div>
                    </div>
                    <svg id="chevron-alumnos" class="w-5 h-5 text-slate-400 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                    </svg>
                </button>
                
                <div id="section-alumnos" class="hidden border-t border-slate-100 p-5 space-y-4 bg-slate-50/30">
                    {{#hasAlumnos}}
                    {{#alumnosAniosList}}
                    <!-- Acordeón por Año -->
                    <div class="bg-white border border-slate-200 rounded-xl shadow-xs overflow-hidden">
                        <button onclick="toggleSection('anio-section-{{anio}}', 'anio-chevron-{{anio}}')" class="w-full flex justify-between items-center px-5 py-4 bg-slate-100/70 hover:bg-slate-100 transition duration-150 text-left focus:outline-none">
                            <span class="text-xs font-bold text-slate-700">📅 Año de Registro: <strong class="text-indigo-600">{{anio}}</strong> ({{count}} alumnos)</span>
                            <svg id="anio-chevron-{{anio}}" class="w-4 h-4 text-slate-400 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                            </svg>
                        </button>
                        
                        <div id="anio-section-{{anio}}" class="hidden border-t border-slate-200">
                            <div class="overflow-x-auto">
                                <table class="w-full text-left border-collapse">
                                    <thead>
                                        <tr class="bg-slate-50/30 border-b border-slate-200 text-[9px] font-bold text-slate-400 uppercase tracking-wider">
                                            <th class="p-3 pl-5">Nombre Completo</th>
                                            <th class="p-3">DNI / Usuario</th>
                                            <th class="p-3">Email</th>
                                            <th class="p-3">Estado</th>
                                            <th class="p-3">Fecha Registro</th>
                                            <th class="p-3 pr-5 text-right">Acciones</th>
                                        </tr>
                                    </thead>
                                    <tbody class="divide-y divide-slate-100 text-xs">
                                        {{#alumnos}}
                                        <tr class="hover:bg-slate-50/50 transition duration-150">
                                            <td class="p-3 pl-5 font-semibold text-slate-900">{{nombre}} {{apellido}}</td>
                                            <td class="p-3 text-slate-500 font-mono text-[11px]">{{username}}</td>
                                            <td class="p-3 text-slate-500">{{email}}</td>
                                            <td class="p-3">
                                                {{#isActivo}}
                                                <span class="bg-emerald-50 border border-emerald-100 text-emerald-700 text-[9px] font-bold px-2 py-0.5 rounded-full">Activo</span>
                                                {{/isActivo}}
                                                {{#isDeshabilitado}}
                                                <span class="bg-slate-100 border border-slate-200 text-slate-500 text-[9px] font-bold px-2 py-0.5 rounded-full">Deshabilitado</span>
                                                {{/isDeshabilitado}}
                                                {{#isPendiente}}
                                                <span class="bg-amber-50 border border-amber-100 text-amber-700 text-[9px] font-bold px-2 py-0.5 rounded-full">Pendiente</span>
                                                {{/isPendiente}}
                                                {{#isRechazado}}
                                                <span class="bg-red-50 border border-red-100 text-red-700 text-[9px] font-bold px-2 py-0.5 rounded-full">Rechazado</span>
                                                {{/isRechazado}}
                                            </td>
                                            <td class="p-3 text-slate-400 font-medium">{{creado_en}}</td>
                                            <td class="p-3 pr-5 text-right">
                                                <div class="inline-flex items-center space-x-2">
                                                    {{#isActivo}}
                                                    <form action="/admin/deshabilitar/{{id}}" method="post" onsubmit="return handleUserForm(event, this);" class="inline">
                                                        <button type="submit" class="bg-red-50 hover:bg-red-100 text-red-600 font-semibold px-3 py-1.5 rounded-lg text-[10px] transition duration-150">
                                                            Deshabilitar
                                                        </button>
                                                    </form>
                                                    {{/isActivo}}
                                                    {{#isDeshabilitado}}
                                                    <form action="/admin/habilitar/{{id}}" method="post" onsubmit="return handleUserForm(event, this);" class="inline">
                                                        <button type="submit" class="bg-emerald-600 hover:bg-emerald-700 text-white font-semibold px-3 py-1.5 rounded-lg text-[10px] transition duration-150">
                                                            Habilitar
                                                        </button>
                                                    </form>
                                                    {{/isDeshabilitado}}
                                                    {{#isRechazado}}
                                                    <form action="/admin/aprobar/{{id}}" method="post" onsubmit="return handleUserForm(event, this);" class="inline">
                                                        <button type="submit" class="bg-emerald-600 hover:bg-emerald-700 text-white font-semibold px-3 py-1.5 rounded-lg text-[10px] transition duration-150">
                                                            Aprobar
                                                        </button>
                                                    </form>
                                                    {{/isRechazado}}
                                                    {{#isPendiente}}
                                                    <form action="/admin/aprobar/{{id}}" method="post" onsubmit="return handleUserForm(event, this);" class="inline">
                                                        <button type="submit" class="bg-emerald-600 hover:bg-emerald-700 text-white font-semibold px-2 py-1 rounded-lg text-[10px] transition duration-150">
                                                            Aprobar
                                                        </button>
                                                    </form>
                                                    <form action="/admin/rechazar/{{id}}" method="post" onsubmit="return handleUserForm(event, this);" class="inline">
                                                        <button type="submit" class="bg-red-50 hover:bg-red-100 text-red-600 font-semibold px-2 py-1 rounded-lg text-[10px] transition duration-150">
                                                            Rechazar
                                                        </button>
                                                    </form>
                                                    {{/isPendiente}}
                                                    <form action="/admin/eliminar/{{id}}" method="post" onsubmit="return handleUserForm(event, this, '¿Seguro que deseas eliminar a este alumno permanentemente? Esta acción es irreversible y borrará todos sus datos e historial.');" class="inline">
                                                        <button type="submit" class="bg-red-600 hover:bg-red-700 text-white font-semibold px-3 py-1.5 rounded-lg text-[10px] transition duration-150">
                                                            Eliminar
                                                        </button>
                                                    </form>
                                                </div>
                                            </td>
                                        </tr>
                                        {{/alumnos}}
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                    {{/alumnosAniosList}}
                    {{/hasAlumnos}}
                    {{^hasAlumnos}}
                    <div class="p-8 text-center text-slate-400 text-xs bg-white rounded-xl border border-slate-200">No hay alumnos registrados.</div>
                    {{/hasAlumnos}}
                </div>
            </div>

            </div>
            {{/hasUsuarios}}
        </div>

        <!-- Script de JavaScript para manejar el acordeón -->
        <script>
            function toggleSection(sectionId, chevronId) {
                const section = document.getElementById(sectionId);
                const chevron = document.getElementById(chevronId);
                if (section.classList.contains('hidden')) {
                    section.classList.remove('hidden');
                    chevron.classList.add('rotate-180');
                } else {
                    section.classList.add('hidden');
                    chevron.classList.remove('rotate-180');
                }
            }

            function handleUserForm(event, form, confirmMsg) {
                if (confirmMsg && !confirm(confirmMsg)) {
                    return false;
                }
                event.preventDefault();

                // Guardar las secciones abiertas
                const openSectionIds = [];
                document.querySelectorAll('[id^="section-"], [id^="anio-section-"]').forEach(el => {
                    if (!el.classList.contains('hidden')) {
                        openSectionIds.push(el.id);
                    }
                });

                fetch(form.action, {
                    method: 'POST',
                    body: new URLSearchParams(new FormData(form)),
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded'
                    }
                })
                .then(response => {
                    return fetch(response.url || '/admin/usuarios');
                })
                .then(response => response.text())
                .then(html => {
                    const parser = new DOMParser();
                    const doc = parser.parseFromString(html, 'text/html');

                    // Reemplazar el contenedor principal de usuarios
                    const newContent = doc.getElementById('users-main-container');
                    const oldContent = document.getElementById('users-main-container');
                    if (newContent && oldContent) {
                        oldContent.innerHTML = newContent.innerHTML;
                    }

                    // Reemplazar alertas
                    const newAlerts = doc.getElementById('alerts-container');
                    const oldAlerts = document.getElementById('alerts-container');
                    if (newAlerts && oldAlerts) {
                        oldAlerts.innerHTML = newAlerts.innerHTML;
                        oldAlerts.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
                    }

                    // Restaurar las secciones que estaban abiertas
                    openSectionIds.forEach(id => {
                        const el = document.getElementById(id);
                        if (el) {
                            el.classList.remove('hidden');
                            // Encontrar el chevron correspondiente
                            let chevronId = '';
                            if (id === 'section-docentes') chevronId = 'chevron-docentes';
                            else if (id === 'section-alumnos') chevronId = 'chevron-alumnos';
                            else if (id.startsWith('anio-section-')) {
                                const anio = id.replace('anio-section-', '');
                                chevronId = 'anio-chevron-' + anio;
                            }
                            const chevron = document.getElementById(chevronId);
                            if (chevron) {
                                chevron.classList.add('rotate-180');
                            }
                        }
                    });
                })
                .catch(err => {
                    console.error(err);
                    alert('Error al procesar la solicitud: ' + err.message);
                });

                return false;
            }
        </script>

    </main>

</body>
</html>
