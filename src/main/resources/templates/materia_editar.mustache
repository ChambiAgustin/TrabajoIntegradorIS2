<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Modificar Materia - Aula Virtual</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
        }
    </style>
</head>
<body class="bg-slate-50 text-slate-800 min-h-screen flex flex-col">

    <!-- Header / Navbar -->
    <header class="bg-white border-b border-slate-200 sticky top-0 z-50 px-6 py-4 shadow-sm">
        <div class="max-w-7xl mx-auto flex justify-between items-center">
            <div class="flex items-center space-x-3">
                <span class="bg-gradient-to-tr from-blue-600 to-indigo-600 text-white p-2 rounded-lg font-bold text-lg shadow-md shadow-blue-200">AV</span>
                <h1 class="text-xl font-bold tracking-tight text-slate-900">Aula Virtual</h1>
            </div>
            <div class="flex items-center space-x-4">
                <span class="text-sm text-slate-500">Conectado como <strong class="text-slate-800 font-semibold">{{currentUser}}</strong></span>
                <a href="/planificacion/materia/{{materiaId}}" class="text-sm font-semibold text-indigo-600 hover:text-indigo-700 transition">&larr; Volver al Detalle de Materia</a>
            </div>
        </div>
    </header>

    <!-- Main Content -->
    <main class="flex-grow max-w-6xl w-full mx-auto p-6 md:p-8 flex flex-col space-y-8">
        
        <!-- Subject Header Card -->
        <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6 md:p-8 flex flex-col md:flex-row justify-between items-start md:items-center gap-6">
            <div class="space-y-2">
                <div class="flex items-center space-x-3">
                    <span class="bg-indigo-100 text-indigo-800 text-xs font-extrabold px-2.5 py-1 rounded-full uppercase tracking-wider">
                        {{materiaAnio}}° Año • {{materiaPeriodo}}
                    </span>
                    <span class="bg-slate-100 text-slate-600 text-xs font-bold px-2 py-1 rounded">
                        Código: {{materiaCodigo}}
                    </span>
                </div>
                <h2 class="text-2xl md:text-3xl font-extrabold text-slate-900 tracking-tight">Modificar Materia: {{materiaNombre}}</h2>
                <p class="text-sm text-slate-500 font-medium">Panel de configuración académica para administradores</p>
            </div>
            
            <a href="/planificacion/materia/{{materiaId}}" class="text-slate-600 hover:text-slate-900 font-medium text-sm flex items-center space-x-1.5 transition">
                <span>&larr;</span> <span>Volver a la Materia</span>
            </a>
        </div>

        <!-- Alerts -->
        {{#errorMessage}}
        <div class="bg-red-50 border border-red-200 text-red-700 p-4 rounded-xl text-sm shadow-sm flex items-center space-x-3">
            <span>⚠️</span>
            <span>{{errorMessage}}</span>
        </div>
        {{/errorMessage}}

        {{#successMessage}}
        <div class="bg-green-50 border border-green-200 text-green-700 p-4 rounded-xl text-sm shadow-sm flex items-center space-x-3">
            <span>✓</span>
            <span>{{successMessage}}</span>
        </div>
        {{/successMessage}}

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            
            <!-- Left Column: Modify subject details -->
            <section class="flex flex-col space-y-6">
                <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6">
                    <h3 class="font-bold text-slate-900 text-base mb-4 flex items-center space-x-2">
                        <span>⚙️</span> <span>Modificar Datos de la Materia</span>
                    </h3>
                    <p class="text-xs text-slate-500 mb-4">Actualiza la información básica de la asignatura como el año, cuatrimestre y la carga horaria semanal.</p>
                    <form action="/planificacion/materia/editar" method="post" class="space-y-4">
                        <input type="hidden" name="id_materia" value="{{materiaId}}">
                        
                        <div>
                            <label for="nombre" class="block text-xs font-semibold text-slate-600 uppercase tracking-wide mb-1">Nombre de la Materia:</label>
                            <input type="text" id="nombre" name="nombre" value="{{materiaNombre}}" required
                                   class="w-full border border-slate-200 rounded-xl px-4 py-2.5 text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500 focus:outline-none">
                        </div>

                        <div>
                            <label for="codigo" class="block text-xs font-semibold text-slate-600 uppercase tracking-wide mb-1">Código:</label>
                            <input type="text" id="codigo" name="codigo" value="{{materiaCodigo}}" required
                                   class="w-full border border-slate-200 rounded-xl px-4 py-2.5 text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500 focus:outline-none">
                        </div>

                        <div class="grid grid-cols-2 gap-4">
                            <div>
                                <label for="anio" class="block text-xs font-semibold text-slate-600 uppercase tracking-wide mb-1">Año:</label>
                                <select id="anio" name="anio" required
                                        class="w-full border border-slate-200 rounded-xl px-4 py-2.5 text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500 focus:outline-none">
                                    <option value="1">1° Año</option>
                                    <option value="2">2° Año</option>
                                    <option value="3">3° Año</option>
                                    <option value="4">4° Año</option>
                                    <option value="5">5° Año</option>
                                </select>
                            </div>
                            
                            <div>
                                <label for="carga_horaria" class="block text-xs font-semibold text-slate-600 uppercase tracking-wide mb-1">Carga Horaria (hs):</label>
                                <input type="number" id="carga_horaria" name="carga_horaria" value="{{materiaCarga}}" min="1" max="40" required
                                       class="w-full border border-slate-200 rounded-xl px-4 py-2.5 text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500 focus:outline-none">
                            </div>
                        </div>

                        <div>
                            <label for="periodo" class="block text-xs font-semibold text-slate-600 uppercase tracking-wide mb-1">Cuatrimestre / Periodo:</label>
                            <select id="periodo" name="periodo" required
                                    class="w-full border border-slate-200 rounded-xl px-4 py-2.5 text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500 focus:outline-none">
                                <option value="1° Cuatrimestre">1° Cuatrimestre</option>
                                <option value="2° Cuatrimestre">2° Cuatrimestre</option>
                                <option value="Anual">Anual</option>
                            </select>
                        </div>

                        <button type="submit" class="w-full bg-blue-600 hover:bg-blue-700 text-white font-semibold py-2.5 rounded-xl text-xs transition shadow-md shadow-blue-100">
                            Guardar Cambios
                        </button>
                    </form>

                    <!-- Form: Delete Subject -->
                    <div class="border-t border-slate-100 pt-4 mt-4">
                        <form action="/planificacion/materia/eliminar" method="post" onsubmit="return confirm('¿Seguro que deseas eliminar esta materia permanentemente del plan de estudio? Se borrarán todas sus comisiones, docentes asignados, e inscripciones asociadas.');">
                            <input type="hidden" name="id_materia" value="{{materiaId}}">
                            <button type="submit" class="w-full bg-red-600 hover:bg-red-700 text-white font-semibold py-2.5 rounded-xl text-xs transition shadow-md shadow-red-100 flex justify-center items-center space-x-2">
                                <span>🗑️</span> <span>Eliminar Materia Permanentemente</span>
                            </button>
                        </form>
                    </div>
                </div>
            </section>

            <!-- Right Column: Correlatives management -->
            <section class="flex flex-col space-y-6">
                <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6">
                    <h3 class="font-bold text-slate-900 text-base mb-4 flex items-center space-x-2">
                        <span>🔗</span> <span>Correlatividades Requeridas</span>
                    </h3>
                    <p class="text-xs text-slate-500 mb-4">Define qué materias debe tener aprobadas o regularizadas el alumno para poder inscribirse en esta materia.</p>
                    
                    <!-- Form: Agregar Correlatividad -->
                    <form action="/planificacion/materia/correlativa/agregar" method="post" class="space-y-4 border-b border-slate-100 pb-4 mb-4">
                        <input type="hidden" name="id_materia" value="{{materiaId}}">
                        
                        <div>
                            <label for="id_correlativa" class="block text-xs font-semibold text-slate-600 uppercase tracking-wide mb-1">Materia Correlativa:</label>
                            <select id="id_correlativa" name="id_correlativa" required
                                    class="w-full border border-slate-200 rounded-xl px-4 py-2.5 text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500 focus:outline-none">
                                <option value="">Selecciona una materia...</option>
                                {{#materiasElegibles}}
                                <option value="{{id_materia}}">{{codigo}} - {{nombre}}</option>
                                {{/materiasElegibles}}
                            </select>
                        </div>

                        <div>
                            <label for="tipo" class="block text-xs font-semibold text-slate-600 uppercase tracking-wide mb-1">Requisito:</label>
                            <select id="tipo" name="tipo" required
                                    class="w-full border border-slate-200 rounded-xl px-4 py-2.5 text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500 focus:outline-none">
                                <option value="A">Aprobada</option>
                                <option value="R">Regularizada</option>
                            </select>
                        </div>

                        <button type="submit" {{^hasMateriasElegibles}}disabled class="w-full bg-slate-100 text-slate-400 font-semibold py-2.5 rounded-xl text-xs cursor-not-allowed"{{/hasMateriasElegibles}}{{#hasMateriasElegibles}}class="w-full bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-2.5 rounded-xl text-xs transition shadow-md shadow-indigo-100"{{/hasMateriasElegibles}}>
                            Agregar Correlativa
                        </button>
                    </form>

                    <!-- List of Correlativas -->
                    <div class="space-y-3">
                        <h4 class="text-xs font-bold text-slate-700">Correlativas configuradas:</h4>
                        {{#correlativas}}
                        <div class="flex items-center justify-between border-b border-slate-100 pb-2.5 last:border-0 last:pb-0">
                            <div class="flex flex-col space-y-0.5">
                                <span class="font-bold text-slate-800 text-xs">{{codigo}} - {{nombre}}</span>
                                <div>
                                    {{#is_aprobada}}
                                    <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold bg-emerald-50 text-emerald-700 border border-emerald-100">Debe estar Aprobada</span>
                                    {{/is_aprobada}}
                                    {{#is_regularizada}}
                                    <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold bg-blue-50 text-blue-700 border border-blue-100">Debe estar Regularizada</span>
                                    {{/is_regularizada}}
                                </div>
                            </div>
                            <form action="/planificacion/materia/correlativa/eliminar" method="post" onsubmit="return confirm('¿Seguro que deseas eliminar esta correlatividad?');" class="inline">
                                <input type="hidden" name="id_materia" value="{{materiaId}}">
                                <input type="hidden" name="id_correlativa" value="{{id_correlativa}}">
                                <button type="submit" class="text-red-500 hover:text-red-700 hover:bg-red-50 font-bold text-sm w-7 h-7 flex items-center justify-center rounded-lg transition" title="Eliminar correlatividad">
                                    ✕
                                </button>
                            </form>
                        </div>
                        {{/correlativas}}
                        {{^hasCorrelativas}}
                        <p class="text-xs text-slate-400 italic py-2 text-center">Esta materia no tiene correlativas configuradas.</p>
                        {{/hasCorrelativas}}
                    </div>
                </div>
            </section>

        </div>

    </main>

    <!-- Footer -->
    <footer class="bg-white border-t border-slate-200 py-6 px-6 text-center text-xs text-slate-500">
        <p>&copy; 2026 Aula Virtual - Trabajo Integrador IS2.</p>
    </footer>

    <script>
        // Pre-select subject parameters in the form
        const anioSelect = document.getElementById('anio');
        if (anioSelect) {
            anioSelect.value = "{{materiaAnio}}";
        }
        const periodoSelect = document.getElementById('periodo');
        if (periodoSelect) {
            periodoSelect.value = "{{materiaPeriodo}}";
        }
    </script>

</body>
</html>
