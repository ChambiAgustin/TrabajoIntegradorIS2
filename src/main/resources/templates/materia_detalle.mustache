<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{#isAdmin}}Gestionar Materia{{/isAdmin}}{{^isAdmin}}Detalle de Materia{{/isAdmin}} - Aula Virtual</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
        }
    </style>
</head>
<body class="bg-slate-50 text-slate-800 min-h-screen flex flex-col">

    <!-- Header / Navbar -->
    <header class="bg-white border-b border-slate-200 sticky top-0 z-50 px-6 py-4 shadow-sm">
        <div class="max-w-7xl mx-auto flex justify-between items-center">
            <div class="flex items-center space-x-3">
                <span class="bg-gradient-to-tr from-blue-600 to-indigo-600 text-white p-2 rounded-lg font-bold text-lg shadow-md shadow-blue-200">AV</span>
                <h1 class="text-xl font-bold tracking-tight text-slate-900">Aula Virtual</h1>
            </div>
            <div class="flex items-center space-x-4">
                <span class="text-sm text-slate-500">Conectado como <strong class="text-slate-800 font-semibold">{{currentUser}}</strong></span>
                <a href="/planificacion" class="text-sm font-semibold text-indigo-600 hover:text-indigo-700 transition">&larr; Volver al Plan de Estudio</a>
            </div>
        </div>
    </header>

    <!-- Main Content -->
    <main class="flex-grow max-w-6xl w-full mx-auto p-6 md:p-8 flex flex-col space-y-8">
        
        <!-- Subject Header Card -->
        <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6 md:p-8 flex flex-col md:flex-row justify-between items-start md:items-center gap-6">
            <div class="space-y-2">
                <div class="flex items-center space-x-3">
                    <span class="bg-indigo-100 text-indigo-800 text-xs font-extrabold px-2.5 py-1 rounded-full uppercase tracking-wider">
                        {{materiaAnio}}° Año • {{materiaPeriodo}}
                    </span>
                    <span class="bg-slate-100 text-slate-600 text-xs font-bold px-2 py-1 rounded">
                        Código: {{materiaCodigo}}
                    </span>
                </div>
                <h2 class="text-2xl md:text-3xl font-extrabold text-slate-900 tracking-tight">{{materiaNombre}}</h2>
                <p class="text-sm text-slate-500">Carga Horaria: <strong class="text-slate-800 font-semibold">{{materiaCarga}} horas semanales</strong></p>
            </div>
            
            <div class="flex items-center space-x-4">
                {{#isAdmin}}
                <a href="/planificacion/materia/{{materiaId}}/editar" class="bg-blue-600 hover:bg-blue-700 text-white font-semibold py-2 px-4 rounded-xl text-sm transition shadow-md shadow-blue-100 flex items-center space-x-2">
                    <span>✏️</span> <span>Modificar Materia</span>
                </a>
                {{/isAdmin}}
                <a href="/planificacion" class="text-slate-600 hover:text-slate-900 font-medium text-sm flex items-center space-x-1.5 transition">
                    <span>&larr;</span> <span>Volver a Planificación</span>
                </a>
            </div>
        </div>

        <!-- Alerts -->
        {{#errorMessage}}
        <div class="bg-red-50 border border-red-200 text-red-700 p-4 rounded-xl text-sm shadow-sm flex items-center space-x-3">
            <span>⚠️</span>
            <span>{{errorMessage}}</span>
        </div>
        {{/errorMessage}}

        {{#successMessage}}
        <div class="bg-green-50 border border-green-200 text-green-700 p-4 rounded-xl text-sm shadow-sm flex items-center space-x-3">
            <span>✓</span>
            <span>{{successMessage}}</span>
        </div>
        {{/successMessage}}

        <div class="flex flex-col md:flex-row gap-8">
            
            <!-- Left Column: Subject Administration (Admins Only) -->
            <section class="w-full md:w-5/12 flex flex-col space-y-6">
                
                {{^isAdmin}}
                <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6 space-y-3">
                    <h3 class="font-bold text-slate-900 text-base flex items-center space-x-2">
                        <span>👨‍🏫</span> <span>Información de Cursada</span>
                    </h3>
                    <p class="text-sm text-slate-600 leading-relaxed">
                        A la derecha se detallan las comisiones activas para esta asignatura junto con los horarios y docentes a cargo.
                    </p>
                </div>
                {{/isAdmin}}

                {{#isAdmin}}

                <!-- Form: Assign Teacher to Subject -->
                <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6">
                    <h3 class="font-bold text-slate-900 text-base mb-4 flex items-center space-x-2">
                        <span>📖</span> <span>Asignar Docente a esta Materia</span>
                    </h3>
                    <p class="text-xs text-slate-500 mb-4">Los docentes asignados a la materia formarán el grupo del cual se podrán seleccionar docentes a cargo de comisiones.</p>
                    <form action="/planificacion/asignar-materia" method="post" class="space-y-4">
                        <input type="hidden" name="id_materia" value="{{materiaId}}">
                        <div>
                            <label for="id_prof" class="block text-xs font-semibold text-slate-600 uppercase tracking-wide mb-1">Docente:</label>
                            <select id="id_prof" name="id_prof" required
                                    class="w-full border border-slate-200 rounded-xl px-4 py-2.5 text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500 focus:outline-none">
                                <option value="">Selecciona un docente...</option>
                                {{#todosDocentes}}
                                <option value="{{id_prof}}">{{apellido}}, {{nombre}}</option>
                                {{/todosDocentes}}
                            </select>
                        </div>
                        <button type="submit" class="w-full bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-2.5 rounded-xl text-xs transition shadow-md shadow-indigo-100">
                            Asignar Docente a Materia
                        </button>
                    </form>
                </div>


                <!-- List of Docentes in Subject -->
                <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6">
                    <h3 class="font-bold text-slate-900 text-base mb-4 flex items-center space-x-2">
                        <span>👥</span> <span>Grupo de Docentes de la Materia</span>
                    </h3>
                    <div class="space-y-3">
                        {{#docentesAsignados}}
                        <div class="flex items-center justify-between border-b border-slate-100 pb-2.5 last:border-0 last:pb-0">
                            <div class="flex items-center space-x-2.5">
                                <span class="w-8 h-8 rounded-full bg-slate-100 text-slate-600 flex items-center justify-center font-bold text-xs">
                                    {{nombre.0}}{{apellido.0}}
                                </span>
                                <div>
                                    <h4 class="font-semibold text-slate-800 text-sm">{{apellido}}, {{nombre}}</h4>
                                    <span class="text-[10px] text-slate-400 font-medium uppercase tracking-wider">Docente Habilitado</span>
                                </div>
                            </div>
                            <form action="/planificacion/remover-docente-materia" method="post" onsubmit="return confirm('¿Seguro que deseas remover a {{nombre}} {{apellido}} de la materia? También se eliminarán sus asignaciones en las comisiones de esta materia.');" class="inline">
                                <input type="hidden" name="id_materia" value="{{materiaId}}">
                                <input type="hidden" name="id_prof" value="{{id_prof}}">
                                <button type="submit" class="text-red-500 hover:text-red-700 hover:bg-red-50 font-bold text-sm w-7 h-7 flex items-center justify-center rounded-lg transition" title="Remover de la materia">
                                    ✕
                                </button>
                            </form>
                        </div>
                        {{/docentesAsignados}}
                        {{^hasDocentesAsignados}}
                        <p class="text-xs text-slate-400 italic py-2 text-center">No hay docentes asociados a esta materia todavía.</p>
                        {{/hasDocentesAsignados}}
                    </div>
                </div>

                {{/isAdmin}}

            </section>

            <!-- Right Column: Commissions List -->
            <section class="flex-grow md:w-7/12 flex flex-col space-y-6">
                <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6 flex flex-col h-full">
                    <h3 class="font-bold text-slate-900 text-lg mb-2 flex items-center space-x-2">
                        <span>🕒</span> <span>Comisiones de la Materia</span>
                    </h3>
                    <p class="text-xs text-slate-500 mb-6">Listado de horarios y asignaciones activas para el presente período académico.</p>
                    
                    <div class="space-y-4 overflow-y-auto flex-1 pr-1">
                        {{#comisiones}}
                        <div class="bg-slate-50/70 border border-slate-100 rounded-xl p-4 md:p-5 flex flex-col justify-between gap-4">
                            
                            <div class="flex justify-between items-start">
                                <div class="space-y-1">
                                    <div class="flex items-center space-x-2">
                                        <span class="text-indigo-600 text-[9px] font-bold tracking-wider uppercase bg-indigo-50 px-2 py-0.5 border border-indigo-100 rounded">{{nombre}}</span>
                                        <span class="text-slate-400 text-[9px] font-bold tracking-wider uppercase bg-white px-2 py-0.5 border border-slate-200 rounded">ID: {{id_comision}}</span>
                                    </div>
                                    <h4 class="font-bold text-slate-900 text-sm tracking-tight pt-1.5 flex items-center">
                                        <span class="mr-2">🕒</span> {{horario}}
                                    </h4>
                                </div>
                            </div>

                            <div class="border-t border-slate-100 pt-3 flex flex-col gap-3">
                                <div class="flex items-center justify-between text-xs">
                                    <span class="text-slate-500 font-semibold flex items-center">
                                        <span class="mr-1.5">👨‍🏫</span> Docente a cargo:
                                    </span>
                                    {{#docente_nombre}}
                                    <span class="text-slate-800 font-bold bg-white px-2 py-1 rounded border border-slate-200">{{docente_nombre}} {{docente_apellido}}</span>
                                    {{/docente_nombre}}
                                    {{^docente_nombre}}
                                    <span class="text-amber-700 font-medium bg-amber-50 px-2 py-1 rounded border border-amber-100">⚠️ Sin docente asignado</span>
                                    {{/docente_nombre}}
                                </div>
                             </div>
                            
                        </div>
                        {{/comisiones}}
                        
                        {{^hasComisiones}}
                        <div class="text-center text-slate-400 py-12">
                            <span class="text-3xl block mb-2">ℹ️</span>
                            <p class="text-xs">No hay comisiones planificadas en este periodo.</p>
                        </div>
                        {{/hasComisiones}}
                    </div>
                </div>
            </section>

        </div>

        <!-- Enrolled Students Section -->
        <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6 mt-8">
            <h3 class="font-bold text-slate-900 text-lg mb-2 flex items-center space-x-2">
                <span>🎓</span> <span>Alumnos Inscriptos</span>
            </h3>
            <p class="text-xs text-slate-500 mb-6">Listado de alumnos inscriptos en esta materia y asignación de sus respectivas comisiones.</p>
            
            <!-- Filtro de Año Lectivo -->
            <form method="get" action="/planificacion/materia/{{materiaId}}" class="flex flex-wrap items-center gap-3 mb-6 bg-slate-50 p-4 rounded-xl border border-slate-100">
                <div class="flex items-center space-x-2">
                    <label for="filter_anio" class="text-xs font-bold text-slate-500 uppercase tracking-wide">Filtrar por Año Lectivo:</label>
                    <input type="number" id="filter_anio" name="anio_lectivo" value="{{selectedAnioLectivo}}" required min="2020" max="2050" class="w-24 border border-slate-200 bg-white rounded-lg px-2.5 py-1.5 text-xs focus:ring-1 focus:ring-blue-500 focus:outline-none" placeholder="Ej. 2026">
                </div>
                <button type="submit" class="bg-indigo-600 hover:bg-indigo-700 active:bg-indigo-800 text-white text-xs font-semibold px-4 py-1.5 rounded-lg transition shadow-sm">
                    Filtrar Alumnos
                </button>
                <span class="text-[10px] text-slate-400 font-semibold italic ml-auto">
                    Mostrando inscripciones de: {{selectedAnioLectivo}}
                </span>
            </form>

            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="border-b border-slate-200 text-xs font-semibold text-slate-400 uppercase tracking-wide">
                            <th class="py-3 px-4">Alumno</th>
                            <th class="py-3 px-4">Período de Inscripción</th>
                            <th class="py-3 px-4">Comisión Asignada</th>
                            {{#isAdmin}}
                            <th class="py-3 px-4 text-right">Asignar / Cambiar Comisión</th>
                            {{/isAdmin}}
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100 text-sm">
                        {{#inscriptos}}
                        <tr>
                            <td class="py-4 px-4 font-medium text-slate-950">
                                {{alumno_apellido}}, {{alumno_nombre}}
                            </td>
                            <td class="py-4 px-4 text-slate-500 text-xs">
                                {{anio_lectivo}} - {{cuatrimestre}}
                            </td>
                            <td class="py-4 px-4">
                                {{#comision_asignada}}
                                <span class="bg-emerald-50 text-emerald-700 text-xs font-semibold px-2.5 py-1 border border-emerald-100 rounded-lg">
                                    {{nombre_comision_asignada}}
                                </span>
                                {{/comision_asignada}}
                                {{^comision_asignada}}
                                <span class="bg-amber-50 text-amber-700 text-xs font-semibold px-2.5 py-1 border border-amber-100 rounded-lg">
                                    ⚠️ Sin comisión asignada
                                </span>
                                {{/comision_asignada}}
                            </td>
                            {{#isAdmin}}
                            <td class="py-4 px-4">
                                <form action="/planificacion/materia/asignar-comision" method="post" class="flex gap-2 items-center justify-end">
                                    <input type="hidden" name="id_inscripcion" value="{{id_inscripcion}}">
                                    <input type="hidden" name="id_materia" value="{{materiaId}}">
                                    <select name="id_comision" class="border border-slate-200 bg-white rounded-lg px-2.5 py-1.5 text-xs focus:ring-1 focus:ring-blue-500 focus:outline-none">
                                        <option value="">Sin asignar / Desasignar</option>
                                        {{#comisionesOpciones}}
                                        <option value="{{id_comision}}" {{#selected}}selected{{/selected}}>{{nombre}}</option>
                                        {{/comisionesOpciones}}
                                    </select>
                                    <button type="submit" class="bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-semibold px-3 py-1.5 rounded-lg transition shadow-sm">
                                        Asignar
                                    </button>
                                </form>
                            </td>
                            {{/isAdmin}}
                        </tr>
                        {{/inscriptos}}
                        {{^hasInscriptos}}
                        <tr>
                            <td colspan="{{#isAdmin}}4{{/isAdmin}}{{^isAdmin}}3{{/isAdmin}}" class="text-center text-slate-400 py-8 italic text-xs">
                                No hay alumnos inscriptos en esta materia todavía.
                            </td>
                        </tr>
                        {{/hasInscriptos}}
                    </tbody>
                </table>
            </div>
        </div>

    </main>

    <!-- Footer -->
    <footer class="bg-white border-t border-slate-200 py-6 px-6 text-center text-xs text-slate-500">
        <p>&copy; 2026 Aula Virtual - Trabajo Integrador IS2.</p>
    </footer>


</body>
</html>
