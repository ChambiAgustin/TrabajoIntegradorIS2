<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mensajes Privados - Aula Virtual</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
        }
        .chat-container {
            height: calc(100vh - 12rem);
        }
    </style>
</head>
<body class="bg-slate-50 text-slate-800 min-h-screen flex flex-col">

    <!-- Header / Navbar -->
    <header class="bg-white border-b border-slate-200 sticky top-0 z-50 px-6 py-4 shadow-sm">
        <div class="max-w-7xl mx-auto flex justify-between items-center">
            <div class="flex items-center space-x-3">
                <span class="bg-gradient-to-tr from-blue-600 to-indigo-600 text-white p-2 rounded-lg font-bold text-lg shadow-md shadow-blue-200">AV</span>
                <h1 class="text-xl font-bold tracking-tight text-slate-900">Aula Virtual</h1>
            </div>
            <div class="flex items-center space-x-4">
                <span class="text-sm text-slate-500">Conectado como <strong class="text-slate-800 font-semibold">{{currentUser}}</strong></span>
                <a href="/dashboard" class="text-sm font-semibold text-indigo-600 hover:text-indigo-700 transition">Volver al Panel</a>
            </div>
        </div>
    </header>

    <!-- Main Content Area -->
    <main class="flex-1 max-w-7xl w-full mx-auto p-6 flex flex-col md:flex-row gap-6">
        
        <!-- Sidebar - Contacts List -->
        <section class="w-full md:w-80 bg-white border border-slate-200 rounded-2xl shadow-sm flex flex-col overflow-hidden">
            <div class="p-4 border-b border-slate-100 bg-slate-50/50">
                <h2 class="font-bold text-slate-950 flex items-center space-x-2">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 text-indigo-600">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M4.26 10.147a60.438 60.438 0 0 0-.491 6.347A48.62 48.62 0 0 1 12 20.904a48.62 48.62 0 0 1 8.232-4.41 60.46 60.46 0 0 0-.491-6.347m-15.482 0a50.636 50.636 0 0 0-2.658-.813A5.906 5.906 0 0 1 1.15 9.807a5.906 5.906 0 0 1 2.91-4.984 50.666 50.666 0 0 1 15.88 0 5.906 5.906 0 0 1 2.91 4.984 5.906 5.906 0 0 1-2.022 4.353m-15.482 0a50.755 50.755 0 0 1 15.482 0m-15.482 0c.397.104.793.223 1.188.358m14.294-0.358c-.397.104-.793.223-1.188.358M12 14a3 3 0 1 1-6 0 3 3 0 0 1 6 0Zm0 0a3 3 0 1 0 6 0 3 3 0 0 0-6 0Z" />
                    </svg>
                    <span>{{sidebarTitle}}</span>
                </h2>
                <p class="text-xs text-slate-500 mt-1">{{sidebarSubtitle}}</p>
            </div>
            
            <div class="flex-1 overflow-y-auto divide-y divide-slate-100 flex flex-col">
                <div class="p-2 space-y-2 flex-1 overflow-y-auto" id="accordionContainer">
                    {{#subjects}}
                    <div class="border border-slate-200 rounded-xl overflow-hidden bg-white shadow-sm transition-all duration-300" data-subject-id="{{id}}">
                        <!-- Subject Header -->
                        <button onclick="toggleAccordion('subject-{{id}}')" 
                                class="w-full flex items-center justify-between p-3 bg-slate-50 hover:bg-slate-100 text-left font-bold text-slate-800 text-sm border-b border-slate-100 transition">
                            <span class="flex items-center space-x-2">
                                <span class="bg-indigo-100 text-indigo-800 text-xs px-2 py-0.5 rounded font-semibold">{{codigo}}</span>
                                <span class="truncate max-w-[140px]">{{nombre}}</span>
                            </span>
                            <div class="flex items-center space-x-2">
                                {{#hasUnread}}
                                <span class="bg-red-500 text-white text-[10px] font-bold px-2 py-0.5 rounded-full shadow-sm">{{unreadCount}}</span>
                                {{/hasUnread}}
                                <svg id="icon-subject-{{id}}" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-4 h-4 text-slate-500 transition-transform duration-200">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" />
                                </svg>
                            </div>
                        </button>
                        
                        <!-- Subject Content (Commissions) -->
                        <div id="subject-{{id}}" class="hidden divide-y divide-slate-100">
                            {{#comisiones}}
                            <div data-commission-id="{{id}}">
                                <!-- Commission Header -->
                                <button onclick="toggleAccordion('commission-{{id}}')" 
                                        class="w-full flex items-center justify-between p-2.5 pl-6 bg-slate-50/50 hover:bg-slate-100/70 text-left font-semibold text-slate-700 text-xs transition">
                                    <span class="truncate flex items-center space-x-2">
                                        <span class="w-1.5 h-1.5 rounded-full bg-indigo-500"></span>
                                        <span>Comisión: {{horario}}</span>
                                    </span>
                                    <div class="flex items-center space-x-2">
                                        {{#hasUnread}}
                                        <span class="bg-red-500 text-white text-[10px] font-bold px-1.5 py-0.5 rounded-full shadow-sm">{{unreadCount}}</span>
                                        {{/hasUnread}}
                                        <svg id="icon-commission-{{id}}" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-3.5 h-3.5 text-slate-400 transition-transform duration-200">
                                            <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" />
                                        </svg>
                                    </div>
                                </button>
                                
                                <!-- Commission Content (Contacts) -->
                                <div id="commission-{{id}}" class="hidden bg-white py-1">
                                    {{#contacts}}
                                    <a href="/messages?with={{id}}&commission={{commissionId}}" 
                                       class="block py-2.5 px-8 hover:bg-slate-50 transition-colors {{#selected}}bg-indigo-50/70 hover:bg-indigo-50 border-r-4 border-indigo-600{{/selected}}"
                                       data-contact-id="{{id}}">
                                        <div class="flex items-center justify-between">
                                            <div class="flex items-center space-x-3 min-w-0">
                                                <div class="w-8 h-8 rounded-full bg-indigo-100 text-indigo-700 flex items-center justify-center font-bold text-xs shrink-0">
                                                    {{initials}}
                                                </div>
                                                <div class="flex-1 min-w-0">
                                                    <p class="text-xs font-semibold text-slate-900 truncate">{{fullName}}</p>
                                                    <p class="text-[10px] text-slate-500 truncate">@{{name}}</p>
                                                </div>
                                            </div>
                                            {{#hasUnread}}
                                            <span class="bg-red-500 text-white text-[10px] font-bold px-1.5 py-0.5 rounded-full shrink-0 ml-2 shadow-sm">{{unreadCount}}</span>
                                            {{/hasUnread}}
                                        </div>
                                    </a>
                                    {{/contacts}}
                                    {{^contacts}}
                                    <p class="text-center text-[10px] text-slate-400 py-2">No hay contactos disponibles.</p>
                                    {{/contacts}}
                                </div>
                            </div>
                            {{/comisiones}}
                            {{^comisiones}}
                            <p class="text-center text-[10px] text-slate-400 py-3">No hay comisiones asociadas.</p>
                            {{/comisiones}}
                        </div>
                    </div>
                    {{/subjects}}
                    {{^subjects}}
                    <div class="p-8 text-center text-slate-400 text-sm">
                        No hay materias ni contactos disponibles en este momento.
                    </div>
                    {{/subjects}}
                </div>
            </div>
        </section>

        <!-- Chat Conversation Section -->
        <section class="flex-1 bg-white border border-slate-200 rounded-2xl shadow-sm flex flex-col overflow-hidden">
            
            {{#selectedContact}}
            <!-- Chat Header -->
            <div class="p-4 border-b border-slate-100 flex items-center justify-between bg-slate-50/50">
                <div class="flex items-center space-x-3">
                    <div class="w-10 h-10 rounded-full bg-indigo-600 flex items-center justify-center text-white font-bold">
                        {{selectedContactInitials}}
                    </div>
                    <div>
                        <h3 class="font-bold text-slate-900">{{selectedContact.name}}</h3>
                        <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                            <span class="w-1.5 h-1.5 bg-green-500 rounded-full mr-1.5 animate-pulse"></span>
                            Chat Activo
                        </span>
                    </div>
                </div>
            </div>

            <!-- Messages Thread Area -->
            <div class="flex-1 p-6 overflow-y-auto bg-slate-50/30 flex flex-col space-y-4 chat-container" id="chatWindow">
                {{#messages}}
                <div class="flex flex-col {{#isSender}}items-end{{/isSender}}{{^isSender}}items-start{{/isSender}}">
                    <div class="max-w-[75%] rounded-2xl px-4 py-3 shadow-sm text-sm
                                {{#isSender}}bg-indigo-600 text-white rounded-tr-none{{/isSender}}
                                {{^isSender}}bg-white text-slate-800 border border-slate-100 rounded-tl-none{{/isSender}}">
                        <p class="whitespace-pre-line leading-relaxed">{{contenido}}</p>
                    </div>
                    <span class="text-[10px] text-slate-400 mt-1 px-1">{{fecha}}</span>
                </div>
                {{/messages}}
                
                {{^messages}}
                <div class="flex-1 flex flex-col items-center justify-center text-slate-400 py-12">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-12 h-12 mb-3 text-slate-300">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 20.25c4.97 0 9-3.694 9-8.25s-4.03-8.25-9-8.25S3 7.444 3 12c0 2.104.859 4.023 2.273 5.48.432.447.74 1.04.586 1.641a4.483 4.483 0 0 1-.923 1.785 5.969 5.969 0 0 0 2.748-.83c.475-.247 1.066-.164 1.545.147A8.961 8.961 0 0 0 12 20.25Z" />
                    </svg>
                    <p class="text-sm">No hay mensajes anteriores en esta conversación.</p>
                    <p class="text-xs text-slate-400 mt-1">¡Escribe un mensaje abajo para comenzar!</p>
                </div>
                {{/messages}}
            </div>

            <!-- Message Form Input -->
            <div class="p-4 border-t border-slate-100 bg-white">
                <form action="/messages" method="post" class="flex items-end gap-3" id="messageForm">
                    <input type="hidden" name="id_receptor" value="{{selectedContact.id}}">
                    <input type="hidden" name="id_comision" value="{{selectedCommissionId}}">
                    <div class="flex-1">
                        <textarea name="contenido" rows="1" required placeholder="Escribe tu mensaje privado aquí..."
                                  class="w-full border border-slate-200 rounded-xl px-4 py-3 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 resize-none text-sm transition"
                                  id="messageInput"></textarea>
                    </div>
                    <button type="submit"
                            class="bg-indigo-600 hover:bg-indigo-700 active:bg-indigo-800 text-white font-semibold py-3 px-6 rounded-xl flex items-center space-x-2 transition shadow-lg shadow-indigo-200">
                        <span>Enviar</span>
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4">
                            <path d="M3.478 2.404a.75.75 0 0 0-.926.941l2.432 7.905H13.5a.75.75 0 0 1 0 1.5H4.984l-2.432 7.905a.75.75 0 0 0 .926.94 60.519 60.519 0 0 0 18.445-8.986.75.75 0 0 0 0-1.218A60.517 60.517 0 0 0 3.478 2.404Z" />
                        </svg>
                    </button>
                </form>
            </div>
            {{/selectedContact}}

            {{^selectedContact}}
            <!-- Placeholder for when no contact is selected -->
            <div class="flex-1 flex flex-col items-center justify-center p-8 text-center text-slate-400 bg-slate-50/10">
                <div class="w-16 h-16 rounded-full bg-slate-100 flex items-center justify-center text-slate-400 mb-4 shadow-inner">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-8 h-8">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M8.625 9.75a.625.625 0 1 1-1.25 0 .625.625 0 0 1 1.25 0Zm0 0H8.25m4.125 0a.625.625 0 1 1-1.25 0 .625.625 0 0 1 1.25 0Zm0 0H12m4.125 0a.625.625 0 1 1-1.25 0 .625.625 0 0 1 1.25 0Zm0 0h-.375m-13.5 3.01H18.75m-15 0a2.25 2.25 0 0 0 2.25 2.25h13.5a2.25 2.25 0 0 0 2.25-2.25m-18 0V7.5A2.25 2.25 0 0 1 5.25 5.25h13.5A2.25 2.25 0 0 1 21 7.5v5.25m-18 0A2.25 2.25 0 0 0 5.25 15h13.5A2.25 2.25 0 0 0 21 12.75" />
                    </svg>
                </div>
                <h3 class="text-lg font-bold text-slate-800 mb-1">Bandeja de Mensajes</h3>
                <p class="max-w-xs text-sm">Selecciona un contacto del listado de la izquierda para comenzar a conversar de forma privada.</p>
            </div>
            {{/selectedContact}}

        </section>
    </main>

    <!-- Scroll to bottom on load, accordion toggles and handle enter to send -->
    <script>
        function toggleAccordion(id) {
            const el = document.getElementById(id);
            const icon = document.getElementById('icon-' + id);
            if (el) {
                if (el.classList.contains('hidden')) {
                    el.classList.remove('hidden');
                    if (icon) icon.classList.add('rotate-180');
                } else {
                    el.classList.add('hidden');
                    if (icon) icon.classList.remove('rotate-180');
                }
            }
        }

        window.addEventListener('DOMContentLoaded', () => {
            const chatWindow = document.getElementById('chatWindow');
            if (chatWindow) {
                chatWindow.scrollTop = chatWindow.scrollHeight;
            }

            const messageInput = document.getElementById('messageInput');
            const messageForm = document.getElementById('messageForm');
            if (messageInput && messageForm) {
                messageInput.addEventListener('keydown', (e) => {
                    if (e.key === 'Enter' && !e.shiftKey) {
                        e.preventDefault();
                        messageForm.submit();
                    }
                });
            }

            // Auto-expand active contact accordion if any
            const activeLink = document.querySelector('[data-contact-id].bg-indigo-50\\/70');
            if (activeLink) {
                // Expand commission parent
                const commissionDiv = activeLink.closest('[id^="commission-"]');
                if (commissionDiv) {
                    commissionDiv.classList.remove('hidden');
                    const commId = commissionDiv.id;
                    const commIcon = document.getElementById('icon-' + commId);
                    if (commIcon) commIcon.classList.add('rotate-180');
                    
                    // Expand subject parent
                    const subjectDiv = commissionDiv.closest('[id^="subject-"]');
                    if (subjectDiv) {
                        subjectDiv.classList.remove('hidden');
                        const subjId = subjectDiv.id;
                        const subjIcon = document.getElementById('icon-' + subjId);
                        if (subjIcon) subjIcon.classList.add('rotate-180');
                    }
                }
            }
        });
    </script>
</body>
</html>
