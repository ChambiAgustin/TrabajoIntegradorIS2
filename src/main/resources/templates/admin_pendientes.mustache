<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Solicitudes Pendientes - Panel de Admin</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
        }
    </style>
</head>
<body class="bg-slate-50 text-slate-800 min-h-screen flex flex-col">

    <!-- Header / Navbar -->
    <header class="bg-white border-b border-slate-200 sticky top-0 z-50 px-6 py-4 shadow-sm">
        <div class="max-w-7xl mx-auto flex justify-between items-center">
            <div class="flex items-center space-x-3">
                <span class="bg-gradient-to-tr from-slate-700 to-slate-900 text-white p-2.5 rounded-xl font-bold text-lg shadow-md">AD</span>
                <div>
                    <h1 class="text-sm font-bold tracking-tight text-slate-900">Panel de Control</h1>
                    <p class="text-[10px] text-slate-400 font-semibold tracking-wider uppercase">Administración</p>
                </div>
            </div>
            
            <nav class="hidden md:flex items-center space-x-6">
                <a href="/admin/pendientes" class="text-xs font-bold text-indigo-600 border-b-2 border-indigo-600 pb-1">Pendientes</a>
                <a href="/admin/usuarios" class="text-xs font-semibold text-slate-500 hover:text-slate-900 transition">Usuarios</a>
                <a href="/dashboard" class="text-xs font-semibold text-slate-500 hover:text-slate-900 transition">Dashboard General</a>
            </nav>

            <div class="flex items-center space-x-4">
                <span class="text-xs text-slate-500">Sesión: <strong class="text-slate-800 font-semibold">{{currentUser}}</strong></span>
                <a href="/logout" class="text-xs font-bold bg-red-50 hover:bg-red-100 text-red-600 px-4 py-2 rounded-xl transition duration-150">
                    Cerrar Sesión
                </a>
            </div>
        </div>
    </header>

    <!-- Main Container -->
    <main class="flex-grow max-w-7xl w-full mx-auto p-6 space-y-6">
        
        <!-- Header Section -->
        <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
            <div>
                <h2 class="text-xl font-extrabold text-slate-900">Solicitudes de Registro Pendientes</h2>
                <p class="text-xs text-slate-500 mt-1">Revisa y gestiona las solicitudes de alumnos y docentes que desean ingresar al sistema.</p>
            </div>
            <a href="/admin/usuarios" class="text-xs font-bold text-indigo-600 bg-indigo-50 hover:bg-indigo-100 px-4 py-2.5 rounded-xl transition duration-150">
                Ver Todos los Usuarios →
            </a>
        </div>

        <!-- Alerts -->
        {{#errorMessage}}
        <div class="bg-red-50 border border-red-200 text-red-700 px-5 py-4 rounded-xl flex items-start space-x-3 text-xs shadow-sm">
            <span class="text-base">⚠️</span>
            <div class="flex-1 font-medium">{{errorMessage}}</div>
        </div>
        {{/errorMessage}}

        {{#successMessage}}
        <div class="bg-emerald-50 border border-emerald-200 text-emerald-700 px-5 py-4 rounded-xl flex items-start space-x-3 text-xs shadow-sm">
            <span class="text-base">✅</span>
            <div class="flex-1 font-medium">{{successMessage}}</div>
        </div>
        {{/successMessage}}

        <!-- Pending Table Card -->
        <div class="bg-white border border-slate-200 rounded-2xl shadow-sm overflow-hidden">
            {{#hasPendientes}}
            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="bg-slate-50 border-b border-slate-200 text-[10px] font-bold text-slate-400 uppercase tracking-wider">
                            <th class="p-4 pl-6">Nombre Completo</th>
                            <th class="p-4">DNI</th>
                            <th class="p-4">Email</th>
                            <th class="p-4">Rol Solicitado</th>
                            <th class="p-4">Fecha Solicitud</th>
                            <th class="p-4 pr-6 text-right">Acciones</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100 text-xs">
                        {{#pendientes}}
                        <tr class="hover:bg-slate-50/50 transition duration-150">
                            <td class="p-4 pl-6 font-semibold text-slate-900">{{nombre}} {{apellido}}</td>
                            <td class="p-4 text-slate-500">{{dni}}</td>
                            <td class="p-4 text-slate-500 font-medium">{{email}}</td>
                            <td class="p-4">
                                <span class="px-2 py-0.5 rounded-full text-[9px] font-bold border 
                                    {{#rol}}
                                    bg-indigo-50 border-indigo-100 text-indigo-700
                                    {{/rol}}">
                                    {{rol}}
                                </span>
                            </td>
                            <td class="p-4 text-slate-400">{{creado_en}}</td>
                            <td class="p-4 pr-6 text-right">
                                <div class="inline-flex items-center space-x-2">
                                    <!-- Form Approve -->
                                    <form action="/admin/aprobar/{{id}}" method="post" class="inline">
                                        <button type="submit" 
                                                class="bg-emerald-600 hover:bg-emerald-700 text-white font-semibold px-3 py-1.5 rounded-lg text-[10px] transition duration-150">
                                            Aprobar
                                        </button>
                                    </form>
                                    <!-- Form Reject -->
                                    <form action="/admin/rechazar/{{id}}" method="post" class="inline">
                                        <button type="submit" 
                                                class="bg-red-50 hover:bg-red-100 text-red-600 font-semibold px-3 py-1.5 rounded-lg text-[10px] transition duration-150">
                                            Rechazar
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                        {{/pendientes}}
                    </tbody>
                </table>
            </div>
            {{/hasPendientes}}

            {{^hasPendientes}}
            <!-- Empty State -->
            <div class="p-16 text-center text-slate-400 flex flex-col items-center">
                <div class="w-16 h-16 rounded-full bg-slate-50 flex items-center justify-center text-slate-300 text-3xl mb-4 border border-slate-100">
                    📂
                </div>
                <h3 class="text-sm font-bold text-slate-800 mb-1">No hay solicitudes pendientes</h3>
                <p class="max-w-xs text-xs text-slate-500 leading-relaxed mt-1">
                    ¡Buen trabajo! Todas las solicitudes de registro de alumnos y docentes han sido resueltas.
                </p>
            </div>
            {{/hasPendientes}}
        </div>

        <!-- Header Section Solicitudes Comisión -->
        <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mt-8">
            <div>
                <h2 class="text-xl font-extrabold text-slate-900">Solicitudes de Cambio de Comisión</h2>
                <p class="text-xs text-slate-500 mt-1">Revisa y gestiona las solicitudes de alumnos para cambiar su comisión y horario cohorte.</p>
            </div>
        </div>

        <!-- Commission Change Table Card -->
        <div class="bg-white border border-slate-200 rounded-2xl shadow-sm overflow-hidden">
            {{#hasSolicitudesComision}}
            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="bg-slate-50 border-b border-slate-200 text-[10px] font-bold text-slate-400 uppercase tracking-wider">
                            <th class="p-4 pl-6">Alumno</th>
                            <th class="p-4">Email</th>
                            <th class="p-4">Periodo</th>
                            <th class="p-4">Comisión Actual</th>
                            <th class="p-4">Comisión Solicitada</th>
                            <th class="p-4">Fecha Solicitud</th>
                            <th class="p-4 pr-6 text-right">Acciones</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100 text-xs">
                        {{#solicitudesComision}}
                        <tr class="hover:bg-slate-50/50 transition duration-150">
                            <td class="p-4 pl-6 font-semibold text-slate-900">{{alumno_nombre}} {{alumno_apellido}}</td>
                            <td class="p-4 text-slate-500">{{alumno_email}}</td>
                            <td class="p-4 text-slate-500 font-medium">{{anio_lectivo}} - {{cuatrimestre}}</td>
                            <td class="p-4 text-slate-500">{{comision_actual}}</td>
                            <td class="p-4 font-bold text-indigo-700">{{comision_solicitada}}</td>
                            <td class="p-4 text-slate-400">{{fecha}}</td>
                            <td class="p-4 pr-6 text-right">
                                <div class="inline-flex items-center space-x-2">
                                    <!-- Form Approve -->
                                    <form action="/admin/solicitudes-comision/aprobar/{{id_solicitud}}" method="post" class="inline">
                                        <button type="submit" 
                                                class="bg-emerald-600 hover:bg-emerald-700 text-white font-semibold px-3 py-1.5 rounded-lg text-[10px] transition duration-150">
                                            Aprobar
                                        </button>
                                    </form>
                                    <!-- Form Reject -->
                                    <form action="/admin/solicitudes-comision/rechazar/{{id_solicitud}}" method="post" class="inline">
                                        <button type="submit" 
                                                class="bg-red-50 hover:bg-red-100 text-red-600 font-semibold px-3 py-1.5 rounded-lg text-[10px] transition duration-150">
                                            Rechazar
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                        {{/solicitudesComision}}
                    </tbody>
                </table>
            </div>
            {{/hasSolicitudesComision}}

            {{^hasSolicitudesComision}}
            <!-- Empty State -->
            <div class="p-16 text-center text-slate-400 flex flex-col items-center">
                <div class="w-16 h-16 rounded-full bg-slate-50 flex items-center justify-center text-slate-300 text-3xl mb-4 border border-slate-100">
                    🎒
                </div>
                <h3 class="text-sm font-bold text-slate-800 mb-1">No hay solicitudes de comisión</h3>
                <p class="max-w-xs text-xs text-slate-500 leading-relaxed mt-1">
                    No hay solicitudes pendientes de cambio de comisión por parte de los alumnos en este momento.
                </p>
            </div>
            {{/hasSolicitudesComision}}
        </div>

    </main>

</body>
</html>
